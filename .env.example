# Names only. Real values go in .env.local (git-ignored) and in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email domains the Join form accepts, comma-separated (default vitstudent.ac.in).
JOIN_EMAIL_DOMAINS=vitstudent.ac.in

# Optional, local only: 1 serves the real-content fixtures instead of the database
# (src/lib/data/fixtures.ts). Never set it on Vercel; it refuses to run in production.
DATA_FIXTURES=

# ImageKit, for uploads (the member import now, the admin later). The private key is server-only.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/Rifan
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
